{
  "uid": "sharely-core",
  "title": "Sharely 核心链路",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "sharely"
  ],
  "panels": [
    {
      "id": 1,
      "title": "服务采集状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "网关 QPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(gateway_http_requests_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "网关 5xx 比例",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(gateway_http_requests_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "网关 P95（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(gateway_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "网关错误分类",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class)(rate(gateway_response_errors_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Java 代理错误",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind)(rate(gateway_java_proxy_errors_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Outbox 待发数量（采集正常时）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "interaction_outbox_pending and (interaction_outbox_collection_up == 1) and (time() - interaction_outbox_snapshot_timestamp_seconds < 60)",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Outbox 最老事件年龄（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "interaction_outbox_oldest_age_seconds and (interaction_outbox_collection_up == 1) and (time() - interaction_outbox_snapshot_timestamp_seconds < 60)",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Outbox 采集与发布连接",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"interaction_outbox_collection_up|interaction_outbox_publisher_up\"}",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Outbox 发布结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result)(rate(interaction_outbox_publish_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "通知与 Sidecar 消费连接",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"notification_consumer_up|sidecar_consumer_up\"}",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "通知处理/确认结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result)(rate(notification_consume_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Sidecar 确认结果（非业务成功率）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue,result)(rate(sidecar_consume_total[5m]))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Outbox 发布 P95（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sharely-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(interaction_outbox_publish_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{queue}} {{status}} {{class}} {{result}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
